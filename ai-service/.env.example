# Shared only with backend/.env; generate a long random value and never commit it.
AI_SERVICE_TOKEN=replace-with-a-long-random-token

# AI is off by default. OCR runs locally; structured suggestions need a provider.
AI_PROVIDER=none
# AI_PROVIDER=openai_compatible
# AI_API_KEY=
# AI_MODEL=
# AI_API_BASE_URL=https://api.openai.com/v1

# Optional: path to the Tesseract executable if it is not on PATH.
# TESSERACT_CMD=/path/to/tesseract
