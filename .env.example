# Copy values into frontend/.env and backend/.env as needed.
# Never commit real secrets.

# Backend
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL (Prisma). Replace USER and PASSWORD with local credentials.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/lifeos?schema=public

# Session cookie signing secret (min 32 characters). Generate a unique value locally.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Frontend (Vite)
# Use /api so the Vite dev server proxies to the backend.
VITE_API_BASE_URL=/api
