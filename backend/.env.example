PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL connection (Prisma). Replace USER and PASSWORD with local credentials.
# Do not commit real passwords.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/lifeos?schema=public

# Session cookie signing secret (min 32 characters). Generate a unique value locally.
# Example only â€” never use this placeholder in a real deployment.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Optional overrides
# SESSION_COOKIE_NAME=lifeos.sid
# SESSION_MAX_AGE_MS=604800000

# Private vault storage (never publicly served). Relative paths resolve from backend cwd.
# PRIVATE_STORAGE_ROOT=../private-storage
# MAX_UPLOAD_BYTES=10485760
